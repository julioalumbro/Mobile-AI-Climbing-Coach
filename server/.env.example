# Copy to server/.env for local development. In production, set these in
# the host's environment variables (Railway: service -> Variables).

# Required
GEMINI_API_KEY=
# Any long random string. Protects /api/admin (creating invite codes).
ADMIN_TOKEN=
# Any long random string. Signs video links. Keep it stable across deploys.
SECRET_KEY=
# The deployed PWA's URL(s), comma-separated. No trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional (defaults shown)
GEMINI_MODEL=gemini-3.8-flash
DAILY_TOKEN_BUDGET=1000000
PER_TESTER_DAILY_ANALYSES=15
MAX_VIDEO_SECONDS=20
GEMINI_VIDEO_FPS=1
RETENTION_DAYS=30
DATA_DIR=./data
